rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function studentProfilePath(uid) {
      return /databases/$(database)/documents/studentProfiles/$(uid);
    }

    function isApprovedStudent() {
      return request.auth != null
        && get(studentProfilePath(request.auth.uid)).data.approved == true;
    }

    // Fields a student may fill in from profile.html. Must match TEXT_FIELDS in profile.js
    // (plus email and updatedAt, which the page sets itself).
    // `approved` and `allowedPlaylists` are NOT in this list, so only the project owner
    // can set them in Firebase Console.
    function studentEditableFields() {
      return ['fullName', 'phone', 'dateOfBirth', 'city', 'state', 'country',
              'parentName', 'parentPhone', 'email', 'updatedAt'];
    }

    function optionalText(d, key, maxLength) {
      return d.get(key, '') is string && d.get(key, '').size() <= maxLength;
    }

    function optionalPhone(d, key) {
      return d.get(key, '') == '' || (d[key] is string && d[key].matches('^[+0-9 ()-]{7,20}$'));
    }

    function validStudentDetails(d) {
      return d.fullName is string && d.fullName.size() > 0 && d.fullName.size() <= 100
        && d.phone is string && d.phone.matches('^[+0-9 ()-]{7,20}$')
        && d.dateOfBirth is string && d.dateOfBirth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.city is string && d.city.size() > 0 && d.city.size() <= 80
        && optionalText(d, 'state', 80)
        && optionalText(d, 'country', 80)
        && optionalText(d, 'parentName', 100)
        && optionalPhone(d, 'parentPhone')
        && d.email == request.auth.token.email
        && d.updatedAt == request.time;
    }

    match /studentProfiles/{studentUid} {
      // A signed-in student can read only their own profile document.
      allow get: if request.auth != null && request.auth.uid == studentUid;

      // A signed-in student can create their own profile with their details.
      // They cannot include `approved` or `allowedPlaylists`.
      allow create: if request.auth != null && request.auth.uid == studentUid
        && request.resource.data.keys().hasOnly(studentEditableFields())
        && validStudentDetails(request.resource.data);

      // A student can update their own details, but never `approved` or `allowedPlaylists`.
      allow update: if request.auth != null && request.auth.uid == studentUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(studentEditableFields())
        && validStudentDetails(request.resource.data);

      // Students cannot browse other profiles or delete records.
      allow list, delete: if false;
    }

    match /tutorialPlaylists/{playlistId} {
      // Students can read only playlists included in their own approved profile.
      allow get: if isApprovedStudent()
        && get(studentProfilePath(request.auth.uid)).data.allowedPlaylists is list
        && playlistId in get(studentProfilePath(request.auth.uid)).data.allowedPlaylists;

      // Do not expose the playlist catalog or allow changes from the website.
      allow list, create, update, delete: if false;
    }
  }
}

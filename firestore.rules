rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function studentProfilePath(uid) {
      return /databases/$(database)/documents/studentProfiles/$(uid);
    }

    function isApprovedStudent() {
      return request.auth != null
        && get(studentProfilePath(request.auth.uid)).data.approved == true;
    }

    // ---- Student profile form (profile.html / profile.js) ----
    // Students answer: old or new; old students pick online or offline.
    // `approved` and `allowedPlaylists` are set only by the project owner in Firebase Console.

    // Every field a student may add, change or remove. Must match profile.js.
    // (phone, dateOfBirth, state, country, parentName, parentPhone are from the
    // earlier form; students may only remove them.)
    function studentEditableFields() {
      return ['studentType', 'oldStudentMode', 'fullName',
              'courseLevel', 'whatsapp', 'instructor',
              'location', 'belt', 'parentWhatsapp',
              'age', 'gender', 'city', 'preferredLanguage', 'foundVia', 'foundViaOther',
              'email', 'updatedAt',
              'phone', 'dateOfBirth', 'state', 'country', 'parentName', 'parentPhone'];
    }

    // Fields that may exist on every profile, whichever branch was chosen.
    function commonFields() {
      return ['studentType', 'fullName', 'email', 'updatedAt', 'approved', 'allowedPlaylists'];
    }

    function isPhone(value) {
      return value is string && value.matches('^[+0-9 ()-]{7,20}$');
    }

    function validCommon(d) {
      return d.fullName is string && d.fullName.size() > 0 && d.fullName.size() <= 100
        && d.email == request.auth.token.email
        && d.updatedAt == request.time;
    }

    // Old student, online Silambam
    function validOnline(d) {
      return d.studentType == 'old' && d.oldStudentMode == 'online'
        && d.keys().hasOnly(commonFields().concat(['oldStudentMode', 'courseLevel', 'whatsapp', 'instructor']))
        && d.courseLevel in ['basic', 'intermediate']
        && isPhone(d.whatsapp)
        && d.instructor in ['Dheepan', 'Bowya'];
    }

    // Old student, offline class with Karate
    function validOffline(d) {
      return d.studentType == 'old' && d.oldStudentMode == 'offline'
        && d.keys().hasOnly(commonFields().concat(['oldStudentMode', 'location', 'belt', 'parentWhatsapp']))
        && d.location in ['Arimalam', 'Keelapaniyour', 'Onangudi']
        && d.belt in ['White', 'Yellow', 'Orange', 'Green', 'Blue', 'Purple', 'Brown', 'Black', 'Other']
        && isPhone(d.parentWhatsapp);
    }

    // New student
    function validNew(d) {
      return d.studentType == 'new'
        && d.keys().hasOnly(commonFields().concat(['age', 'gender', 'city', 'preferredLanguage', 'foundVia', 'foundViaOther']))
        && d.age is int && d.age >= 3 && d.age <= 100
        && d.gender in ['male', 'female', 'other', 'prefer-not-to-say']
        && d.city is string && d.city.size() > 0 && d.city.size() <= 80
        && d.preferredLanguage in ['tamil', 'english']
        && d.foundVia in ['instagram', 'youtube', 'whatsapp', 'friend', 'google', 'other']
        && d.get('foundViaOther', '') is string && d.get('foundViaOther', '').size() <= 100
        && (d.foundVia != 'other' || d.get('foundViaOther', '').size() > 0);
    }

    function validStudentDetails(d) {
      return validCommon(d) && (validOnline(d) || validOffline(d) || validNew(d));
    }

    match /studentProfiles/{studentUid} {
      // A signed-in student can read only their own profile document.
      allow get: if request.auth != null && request.auth.uid == studentUid;

      // A student can create their own profile, without `approved` or `allowedPlaylists`.
      allow create: if request.auth != null && request.auth.uid == studentUid
        && !request.resource.data.keys().hasAny(['approved', 'allowedPlaylists'])
        && validStudentDetails(request.resource.data);

      // A student can update their own details, but never `approved` or `allowedPlaylists`.
      allow update: if request.auth != null && request.auth.uid == studentUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(studentEditableFields())
        && validStudentDetails(request.resource.data);

      // Students cannot browse other profiles or delete records.
      allow list, delete: if false;
    }

    match /tutorialPlaylists/{playlistId} {
      // Students can read only playlists included in their own approved profile.
      allow get: if isApprovedStudent()
        && get(studentProfilePath(request.auth.uid)).data.allowedPlaylists is list
        && playlistId in get(studentProfilePath(request.auth.uid)).data.allowedPlaylists;

      // Do not expose the playlist catalog or allow changes from the website.
      allow list, create, update, delete: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function studentProfilePath(uid) {
      return /databases/$(database)/documents/studentProfiles/$(uid);
    }

    function isApprovedStudent() {
      return request.auth != null
        && get(studentProfilePath(request.auth.uid)).data.approved == true;
    }

    match /studentProfiles/{studentUid} {
      // A signed-in student can read only their own profile document.
      allow get: if request.auth != null && request.auth.uid == studentUid;

      // Profile documents are managed by the project owner in Firebase Console.
      allow list, create, update, delete: if false;
    }

    match /tutorialPlaylists/{playlistId} {
      // Students can read only playlists included in their own approved profile.
      allow get: if isApprovedStudent()
        && get(studentProfilePath(request.auth.uid)).data.allowedPlaylists is list
        && playlistId in get(studentProfilePath(request.auth.uid)).data.allowedPlaylists;

      // Do not expose the playlist catalog or allow changes from the website.
      allow list, create, update, delete: if false;
    }
  }
}
